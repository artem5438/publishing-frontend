{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folio Guest",
  "version": "0.1.0",
  "identifier": "ru.folio.guest",
  "build": {
    "beforeDevCommand": "npm run dev:tauri-ui",
    "beforeBuildCommand": "npm run build:tauri-ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folio Guest",
        "width": 1200,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
